// metrix — Prisma schema
// Modelo de persistencia: ScenarioRecord + AuditEntry

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Registro de un escenario (cálculo) guardado. Contrato universal del dominio.
model ScenarioRecord {
  id            String   @id @default(uuid())
  scopeId       String
  module        String // 'quadratic' | 'pricing' | 'roi' | 'actuarial'
  version       Int      @default(1)
  inputHash     String
  formulaVersion String
  status        String   @default("DRAFT") // DRAFT | COMPUTED | SAVED | RE_RUN
  inputs        String // JSON serializado (canónico)
  outputs       String // JSON serializado (inmutable tras SAVED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  audits     AuditEntry[]

  @@index([scopeId, module])
  @@index([inputHash])
  // Dedupe por estado: SAVED y RE_RUN del mismo input coexisten (política D4/D5:
  // re-ejecutar crea NUEVO registro RE_RUN, pero no duplica dentro de un mismo estado).
  @@unique([scopeId, module, inputHash, status])
}

/// Auditoría de mutaciones sobre un escenario (transiciones de estado).
model AuditEntry {
  id        String   @id @default(uuid())
  scenarioId String
  fromStatus String?
  toStatus  String
  action    String // 'CREATE' | 'COMPUTE' | 'SAVE' | 'RE_RUN'
  detail    String?
  createdAt DateTime @default(now())

  scenario ScenarioRecord @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
}

/// Lead capturado por el lead magnet (descarga de informe).
model Lead {
  id        String   @id @default(uuid())
  nombre    String
  empresa   String
  whatsapp  String
  email     String
  /// Desbloqueo por contacto (OBJ-1): "free" | "contact-gated" | "paid"
  /// Nullable: leads previos a Fase 3 no lo tienen.
  access    String?
  createdAt DateTime @default(now())

  @@index([email])
}
