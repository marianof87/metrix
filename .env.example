# metrix — variables de entorno (ejemplo)
# Copie este archivo a .env y ajuste los valores. NO suba secretos reales.

# SQLite vía Prisma — ruta del archivo de base de datos.
# Ruta consistente: el CLI de Prisma la resuelve relativa a prisma/ y el
# cliente runtime relativa al cwd; ambos convergen a prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"