{
  "openapi": "3.0.3",
  "info": {
    "title": "metrix API",
    "version": "0.1.0",
    "description": "API v1 de Metrix AI — calculadoras (cuadrática, precios, ROI, actuarial) + margen honesto (OBJ-2: toda salida es Outcome con range+driver+action+confidence) + historial de escenarios. Frontera gratis/pago (OBJ-1): cada Outcome lleva access."
  },
  "paths": {
    "/api/v1/quadratic": {
      "post": {
        "summary": "Resuelve una función cuadrática f(x)=ax²+bx+c",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["a", "b", "c"],
                "properties": {
                  "a": { "type": "number", "description": "a ≠ 0" },
                  "b": { "type": "number" },
                  "c": { "type": "number" },
                  "sampleStart": { "type": "number" },
                  "sampleEnd": { "type": "number" },
                  "sampleStep": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Resultado con raíces, vértice, concavidad" },
          "400": { "description": "Input inválido (a=0, datos no numéricos)" }
        }
      }
    },
    "/api/v1/pricing": {
      "post": {
        "summary": "Simulador de precios",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["baseCost", "desiredMarginPct"],
                "properties": {
                  "baseCost": { "type": "number", "minimum": 0 },
                  "desiredMarginPct": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "taxPct": { "type": "number", "minimum": 0 },
                  "quantity": { "type": "number", "minimum": 0 },
                  "discountPct": { "type": "number", "minimum": 0, "maximum": 1 },
                  "currency": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Precio sugerido y desglose" },
          "400": { "description": "Input inválido" }
        }
      }
    },
    "/api/v1/roi": {
      "post": {
        "summary": "Calculadora de ROI (simple, anualizado, NPV, payback, TIR)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["initialInvestment"],
                "properties": {
                  "initialInvestment": { "type": "number", "minimum": 0 },
                  "finalValue": { "type": "number" },
                  "periods": { "type": "integer", "minimum": 1 },
                  "cashFlows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["period", "amount"],
                      "properties": {
                        "period": { "type": "integer", "minimum": 1 },
                        "amount": { "type": "number" }
                      }
                    }
                  },
                  "discountRatePct": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Resultado ROI" },
          "400": { "description": "Input inválido o TIR no converge" }
        }
      }
    },
    "/api/v1/actuarial": {
      "post": {
        "summary": "Módulo actuario (interés compuesto, anualidad, valor presente, prima)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["principal", "annualRatePct", "periodsPerYear", "years"],
                "properties": {
                  "principal": { "type": "number", "minimum": 0 },
                  "annualRatePct": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "periodsPerYear": { "type": "number", "exclusiveMinimum": 0 },
                  "years": { "type": "number", "minimum": 0 },
                  "contributionPerPeriod": { "type": "number", "minimum": 0 },
                  "mortality": {
                    "type": "object",
                    "properties": {
                      "age": { "type": "number", "minimum": 0 },
                      "premium": { "type": "number", "minimum": 0 },
                      "coverage": { "type": "number", "minimum": 0 },
                      "mortalityProbability": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Resultado actuarial" },
          "400": { "description": "Input inválido" }
        }
      }
    },
    "/api/v1/margen": {
      "post": {
        "summary": "Margen real por unidad, piso y equilibrio — salida honesta Outcome (OBJ-2)",
        "description": "Ninguna salida es un número falso con decimales: la respuesta es un intervalo con causa y acción.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["precioVenta", "comisionPct", "mermaPct", "ivaPct", "fleteUnitario", "costoUnitario"],
                "properties": {
                  "precioVenta": { "type": "number", "exclusiveMinimum": 0 },
                  "comisionPct": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "mermaPct": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "ivaPct": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "fleteUnitario": { "type": "number", "minimum": 0 },
                  "costoUnitario": { "type": "number", "minimum": 0 },
                  "costosFijosMensuales": { "type": "number", "minimum": 0 }
                },
                "description": "comisionPct + mermaPct + ivaPct debe ser < 1 (refine Zod con tolerancia float)"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Outcomes honestos (OBJ-2). Sin números sueltos a nivel raíz.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outcomes": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Outcome" }
                    },
                    "formulaVersion": { "type": "string" }
                  },
                  "required": ["outcomes"]
                }
              }
            }
          },
          "400": { "description": "Input inválido (Zod con 'Invalid input')" }
        }
      }
    },
    "/api/v1/lead-magnet": {
      "post": {
        "summary": "Simulador de precios del lead magnet — salida honesta Outcome (OBJ-2)",
        "description": "Toma los coeficientes de la curva de demanda y devuelve un rango de precio con causa y acción. Sin números sueltos (precioOptimo/gananciaMaxima quedaron fuera del contrato).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["minPrice", "maxPrice", "demandA", "demandB", "demandC", "costPerUnit"],
                "properties": {
                  "minPrice": { "type": "number", "description": "Precio mínimo del barrido" },
                  "maxPrice": { "type": "number", "description": "Precio máximo (debe ser mayor que minPrice)" },
                  "demandA": { "type": "number", "description": "Coeficiente cuadrático de la curva de demanda (debe ser < 0)" },
                  "demandB": { "type": "number" },
                  "demandC": { "type": "number" },
                  "costPerUnit": { "type": "number", "minimum": 0 }
                },
                "description": "Todos los campos son obligatorios y finitos (Zod). 400 si demandA>=0, maxPrice<=minPrice o costPerUnit<0."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Outcomes honestos + curva técnica de visualización",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "formulaVersion": { "type": "string", "enum": ["lead-magnet-v1"] },
                    "outcomes": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Outcome" }
                    },
                    "curva": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["x", "y"],
                        "properties": {
                          "x": { "type": "number" },
                          "y": { "type": "number" }
                        }
                      },
                      "description": "Serie técnica para el gráfico de ganancia del cliente (data viz; no es un número de decisión)"
                    }
                  },
                  "required": ["formulaVersion", "outcomes", "curva"]
                }
              }
            }
          },
          "400": { "description": "Input inválido (Zod con 'Invalid input')" }
        }
      }
    },
    "/api/v1/scenarios": {
      "get": {
        "summary": "Lista escenarios guardados (filtrable por scopeId, module, status)",
        "parameters": [
          { "name": "scopeId", "in": "query", "schema": { "type": "string" } },
          { "name": "module", "in": "query", "schema": { "type": "string", "enum": ["quadratic", "pricing", "roi", "actuarial"] } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "COMPUTED", "SAVED", "RE_RUN"] } }
        ],
        "responses": {
          "200": { "description": "Lista de escenarios" }
        }
      },
      "post": {
        "summary": "Guarda un escenario (acción explícita Guardar)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["scopeId", "module", "inputs"],
                "properties": {
                  "scopeId": { "type": "string" },
                  "module": { "type": "string", "enum": ["quadratic", "pricing", "roi", "actuarial"] },
                  "inputs": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Escenario guardado" },
          "400": { "description": "Input inválido" }
        }
      }
    },
    "/api/v1/scenarios/{id}": {
      "get": {
        "summary": "Detalle de un escenario + auditoría",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Escenario y audits" },
          "404": { "description": "No encontrado" }
        }
      }
    },
    "/api/v1/scenarios/{id}/re-run": {
      "post": {
        "summary": "Re-ejecuta un escenario desde historial (crea registro RE_RUN)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "description": "Nuevo registro RE_RUN" },
          "400": { "description": "No se pudo re-ejecutar" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Outcome": {
        "type": "object",
        "required": ["id", "range", "driver", "action", "confidence", "access"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Hash canónico del contenido (determinista; incluye access)" },
          "range": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2,
            "description": "Intervalo honesto [min, max]"
          },
          "driver": { "type": "string", "description": "La causa principal del resultado (castellano)" },
          "action": { "type": "string", "description": "Una acción concreta, no un dato (castellano)" },
          "confidence": { "type": "string", "enum": ["baja", "media", "alta"] },
          "access": {
            "type": "string",
            "enum": ["free", "contact-gated", "paid"],
            "description": "OBJ-1 — free si todos los drivers salen de inputs del dueño; contact-gated si se desbloquea con contacto; paid si Metrix aportó un número que el dueño no tenía (cobro no implementado; niveles = decisión de Mariano)"
          }
        }
      }
    }
  }
}